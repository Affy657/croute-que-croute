      "Bash(npx wrangler rollback*)",
      "PowerShell(npm run deploy*)",
      "PowerShell(rtk npm run deploy*)",
      "PowerShell(node scripts/deploy.mjs*)",
      "PowerShell(npx wrangler deploy*)",
      "PowerShell(rtk npx wrangler deploy*)",
      "PowerShell(npm run db:remote*)",
      "PowerShell(rtk npm run db:remote*)",
      "PowerShell(node scripts/migrer.mjs*)",
