{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "croute-que-croute",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "APP_VERSION": "dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "croute-que-croute",
      "database_id": "af1e8422-b6f9-4d26-a5d2-ebdda75970b1",
      "migrations_dir": "migrations"
    }
  ]
}
