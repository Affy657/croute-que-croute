{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "croute-que-croute",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "preview_urls": false,
  "workers_dev": true,
  "routes": [{ "pattern": "croute-que-croute.tartinesauvage.fr", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "APP_VERSION": "dev",
    "APP_PREVIOUS": ""
  },
  "ratelimits": [
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "JOIN_IP_LIMIT", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
    { "name": "ADMIN_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RUN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 10 } },
    { "name": "START_LIMIT", "namespace_id": "1009", "simple": { "limit": 30, "period": 60 } },
    { "name": "START_IP_LIMIT", "namespace_id": "1010", "simple": { "limit": 300, "period": 60 } },
    { "name": "RENAME_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "SOUND_LIMIT", "namespace_id": "1006", "simple": { "limit": 60, "period": 60 } },
    { "name": "ERROR_LIMIT", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIVE_LIMIT", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "Live" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "croute-que-croute",
      "database_id": "af1e8422-b6f9-4d26-a5d2-ebdda75970b1",
      "migrations_dir": "migrations"
    }
  ]
}
