{
  "name": "croute-que-croute",
  "private": true,
  "version": "0.49.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply croute-que-croute --local",
    "seed": "node scripts/seed.mjs",
    "db:remote": "wrangler d1 migrations apply croute-que-croute --remote",
    "deploy": "node scripts/deploy.mjs",
    "icons": "node scripts/icons.mjs",
    "qr": "node scripts/qr.mjs",
    "types": "wrangler types",
    "check": "tsc --noEmit && tsc -p tsconfig.navigateur.json",
    "test": "node test/fairness.mjs 100 150",
    "test:api": "node test/api.mjs",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:navigateur": "node test/api.mjs test/navigateur.mjs",
    "verif": "node scripts/verif.mjs",
    "equilibrage": "node test/equilibrage/comparer.mjs",
    "equilibrage:attaques": "node test/equilibrage/attaques.mjs",
    "equilibrage:vides": "node test/equilibrage/vides.mjs",
    "equilibrage:invariants": "node test/equilibrage/invariants.mjs",
    "equilibrage:variante": "node test/equilibrage/variante.mjs",
    "equilibrage:combos": "node test/equilibrage/combos.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
